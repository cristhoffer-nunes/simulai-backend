// Simulai — modelo de dados (specs/03_DATA_MODEL.md).
//
// Tudo vive no schema `simulai_service` do database do ambiente (dev/tst/prd), na mesma instância
// Postgres do lawsuits-management-backend. Constraints que o Prisma não expressa (índices parciais,
// CHECKs) estão escritas à mão na migration inicial.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema", "relationJoins"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  schemas           = ["simulai_service"]
}

// ─── Identidade e acesso ────────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  passwordHash       String    @map("password_hash")
  displayName        String    @map("display_name") @db.VarChar(80)
  isActive           Boolean   @default(true) @map("is_active")
  // Contas são criadas pelo administrador com senha provisória; o titular define a própria
  // senha no primeiro acesso (link por e-mail) antes de entrar.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  userRoles      UserRole[]
  sessions       AuthSession[]
  passwordResets PasswordResetLink[]
  subjects       Subject[]
  topics         Topic[]
  questions      Question[]
  collections    QuestionCollection[]
  imports        QuestionImport[]
  simulations    Simulation[]
  attempts       SimulationAttempt[]

  @@map("users")
  @@schema("simulai_service")
}

// Sessões (refresh tokens opacos). Só o hash SHA-256 é guardado; a rotação apaga a linha antiga e
// cria outra numa transação, então um token reapresentado não encontra nada.
model AuthSession {
  tokenHash String   @id @map("token_hash") @db.Char(64)
  userId    String   @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
  @@schema("simulai_service")
}

// O único link de senha válido por usuário (primeiro acesso ou recuperação). Emitir outro
// substitui o jti; concluir a troca apaga a linha.
model PasswordResetLink {
  userId    String   @id @map("user_id") @db.Uuid
  jti       String   @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_reset_links")
  @@schema("simulai_service")
}

// Janela fixa de tentativas por chave (login:{email}:{ip}, refresh:{ip}, forgot:...).
model RateLimitBucket {
  key          String   @id @db.VarChar(320)
  attempts     Int
  windowEndsAt DateTime @map("window_ends_at") @db.Timestamptz

  @@index([windowEndsAt])
  @@map("rate_limit_buckets")
  @@schema("simulai_service")
}

model Role {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
  @@schema("simulai_service")
}

model Permission {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  rolePermissions RolePermission[]

  @@map("permissions")
  @@schema("simulai_service")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("simulai_service")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("simulai_service")
}

// ─── Taxonomia ──────────────────────────────────────────────────────────────────────────────────

model KnowledgeArea {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  subjects Subject[]

  @@map("knowledge_areas")
  @@schema("simulai_service")
}

/// ownerUserId nulo = disciplina do catálogo (seed); preenchido = criada pelo aluno, privada (RN-001).
model Subject {
  id              String   @id @default(uuid()) @db.Uuid
  knowledgeAreaId String   @map("knowledge_area_id") @db.Uuid
  ownerUserId     String?  @map("owner_user_id") @db.Uuid
  name            String   @db.VarChar(120)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  knowledgeArea KnowledgeArea @relation(fields: [knowledgeAreaId], references: [id])
  owner         User?         @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  topics        Topic[]
  questions     Question[]

  @@index([ownerUserId])
  @@map("subjects")
  @@schema("simulai_service")
}

model Topic {
  id            String   @id @default(uuid()) @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  parentTopicId String?  @map("parent_topic_id") @db.Uuid
  ownerUserId   String?  @map("owner_user_id") @db.Uuid
  name          String   @db.VarChar(120)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent    Topic?     @relation("TopicTree", fields: [parentTopicId], references: [id], onDelete: SetNull)
  children  Topic[]    @relation("TopicTree")
  owner     User?      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([id, subjectId])
  @@index([subjectId])
  @@map("topics")
  @@schema("simulai_service")
}

// ─── Banco de questões ──────────────────────────────────────────────────────────────────────────

model Question {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  subjectId       String   @map("subject_id") @db.Uuid
  topicId         String?  @map("topic_id") @db.Uuid
  type            String   @default("multiple_choice")
  statement       String
  difficulty      String
  explanation     String
  status          String   @default("active")
  contentHash     String   @map("content_hash")
  sourceImportId  String?  @map("source_import_id") @db.Uuid
  /// Where the content came from (chapter/page), as typed or as given by the AI. Not verified.
  sourceReference String?  @map("source_reference") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  owner               User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  subject             Subject              @relation(fields: [subjectId], references: [id])
  topic               Topic?               @relation(fields: [topicId, subjectId], references: [id, subjectId], onDelete: Restrict)
  sourceImport        QuestionImport?      @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)
  options             QuestionOption[]
  collections         CollectionQuestion[]
  simulationQuestions SimulationQuestion[]

  @@index([ownerUserId, status])
  @@index([ownerUserId, contentHash])
  @@index([ownerUserId, subjectId])
  @@map("questions")
  @@schema("simulai_service")
}

model QuestionOption {
  id         String  @id @default(uuid()) @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  optionKey  String  @map("option_key") @db.VarChar(1)
  text       String
  isCorrect  Boolean @map("is_correct")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, optionKey])
  @@map("question_options")
  @@schema("simulai_service")
}

model QuestionCollection {
  id          String   @id @default(uuid()) @db.Uuid
  ownerUserId String   @map("owner_user_id") @db.Uuid
  name        String   @db.VarChar(120)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner     User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  questions CollectionQuestion[]

  @@index([ownerUserId])
  @@map("question_collections")
  @@schema("simulai_service")
}

model CollectionQuestion {
  collectionId String   @map("collection_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  addedAt      DateTime @default(now()) @map("added_at") @db.Timestamptz

  collection QuestionCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  question   Question           @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([collectionId, questionId])
  @@map("collection_questions")
  @@schema("simulai_service")
}

model QuestionImport {
  id             String    @id @default(uuid()) @db.Uuid
  ownerUserId    String    @map("owner_user_id") @db.Uuid
  schemaVersion  String    @map("schema_version")
  status         String
  totalCount     Int       @map("total_count")
  importedCount  Int       @default(0) @map("imported_count")
  rejectedCount  Int       @default(0) @map("rejected_count")
  duplicateCount Int       @default(0) @map("duplicate_count")
  idempotencyKey String?   @map("idempotency_key")
  /// Validated, normalized items kept server-side until commit (cannot be tampered with).
  preview        Json?
  /// The preview stops being committable after this moment (status stays "validated").
  expiresAt      DateTime? @map("expires_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  committedAt    DateTime? @map("committed_at") @db.Timestamptz

  owner     User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  questions Question[]

  @@unique([ownerUserId, idempotencyKey])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("question_imports")
  @@schema("simulai_service")
}

// ─── Simulados ──────────────────────────────────────────────────────────────────────────────────

model Simulation {
  id              String   @id @default(uuid()) @db.Uuid
  ownerUserId     String   @map("owner_user_id") @db.Uuid
  title           String   @db.VarChar(120)
  /// "exam": gabarito no final; "study": correção a cada resposta confirmada, sem cronômetro.
  mode            String   @default("exam")
  status          String   @default("ready")
  questionCount   Int      @map("question_count")
  difficulty      String   @default("all")
  timed           Boolean
  durationSeconds Int?     @map("duration_seconds")
  configuration   Json
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner     User                 @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  questions SimulationQuestion[]
  attempts  SimulationAttempt[]

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("simulations")
  @@schema("simulai_service")
}

model SimulationQuestion {
  id               String   @id @default(uuid()) @db.Uuid
  simulationId     String   @map("simulation_id") @db.Uuid
  sourceQuestionId String?  @map("source_question_id") @db.Uuid
  position         Int
  snapshot         Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  simulation     Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  sourceQuestion Question?       @relation(fields: [sourceQuestionId], references: [id], onDelete: SetNull)
  answers        AttemptAnswer[]

  @@unique([simulationId, position])
  @@unique([simulationId, sourceQuestionId])
  @@unique([id, simulationId])
  @@map("simulation_questions")
  @@schema("simulai_service")
}

model SimulationAttempt {
  id              String    @id @default(uuid()) @db.Uuid
  simulationId    String    @map("simulation_id") @db.Uuid
  ownerUserId     String    @map("owner_user_id") @db.Uuid
  status          String    @default("in_progress")
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz
  finishedAt      DateTime? @map("finished_at") @db.Timestamptz
  finishReason    String?   @map("finish_reason")
  correctCount    Int?      @map("correct_count")
  incorrectCount  Int?      @map("incorrect_count")
  unansweredCount Int?      @map("unanswered_count")
  scorePercentage Decimal?  @map("score_percentage") @db.Decimal(5, 2)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  simulation Simulation      @relation(fields: [simulationId], references: [id], onDelete: Cascade)
  owner      User            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  answers    AttemptAnswer[]

  @@unique([id, simulationId])
  @@index([ownerUserId, createdAt(sort: Desc)])
  @@index([status, expiresAt])
  @@map("simulation_attempts")
  @@schema("simulai_service")
}

/// simulation_id é redundante de propósito: as FKs compostas garantem que a questão respondida
/// pertence ao mesmo simulado da tentativa (03_DATA_MODEL, "Integridade crítica").
model AttemptAnswer {
  id                   String    @id @default(uuid()) @db.Uuid
  attemptId            String    @map("attempt_id") @db.Uuid
  simulationId         String    @map("simulation_id") @db.Uuid
  simulationQuestionId String    @map("simulation_question_id") @db.Uuid
  selectedOptionKey    String?   @map("selected_option_key") @db.VarChar(1)
  /// "Revisar depois": lembrete do aluno durante a prova; não afeta a nota.
  flagged              Boolean   @default(false)
  answeredAt           DateTime  @map("answered_at") @db.Timestamptz
  /// Modo estudo: quando a resposta foi confirmada (a partir daí não muda e a correção é mostrada).
  confirmedAt          DateTime? @map("confirmed_at") @db.Timestamptz

  attempt            SimulationAttempt  @relation(fields: [attemptId, simulationId], references: [id, simulationId], onDelete: Cascade)
  simulationQuestion SimulationQuestion @relation(fields: [simulationQuestionId, simulationId], references: [id, simulationId], onDelete: Cascade)

  @@unique([attemptId, simulationQuestionId])
  @@map("attempt_answers")
  @@schema("simulai_service")
}

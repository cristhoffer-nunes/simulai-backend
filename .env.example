NODE_ENV=development
PORT=3002

# Mesma instância Postgres do lawsuits-management-backend: um database por ambiente (dev, tst,
# prd) e um schema por serviço. O Simulai usa só o schema `simulai_service`. O parâmetro
# ?schema=simulai_service é obrigatório: é nele que o Prisma guarda a tabela _prisma_migrations
# do Simulai, separada da do lawsuits (que fica em public). Veja README.md, "Provisionamento".
DATABASE_URL=postgresql://simulai_backend_dev:CHANGE_ME@postgres-shared:5432/dev?schema=simulai_service

# Só para `prisma migrate dev` (shadow database). Conexão privilegiada, nunca usada em runtime.
SHADOW_DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres-shared:5432/simulai_shadow

# Par de chaves RS256 próprio do Simulai (npm run keys:generate). Nunca reutilize o do lawsuits:
# um token de um sistema não pode valer no outro. Nunca commite estes arquivos.
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem

# Duração dos tokens, em segundos.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# Origens autorizadas (separadas por vírgula).
CORS_ORIGIN=http://localhost:3000

# Proteção contra força bruta (contadores na tabela rate_limit_buckets).
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
# O app web renova a sessão a cada carregamento de página; por isso o limite de refresh é alto.
REFRESH_RATE_LIMIT_MAX_ATTEMPTS=120
REFRESH_RATE_LIMIT_WINDOW_SECONDS=900

# Links de primeiro acesso e de recuperação de senha.
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
FIRST_ACCESS_TOKEN_TTL_SECONDS=259200
FORGOT_PASSWORD_RATE_LIMIT_MAX_ATTEMPTS=3
FORGOT_PASSWORD_RATE_LIMIT_WINDOW_SECONDS=3600

# Origem do frontend (link de redefinição aponta para …/redefinir-senha?token=...).
FRONTEND_URL=http://localhost:3000

# Resend — e-mails transacionais (boas-vindas/primeiro acesso, recuperação, senha alterada).
# Vazio em dev: o envio falha no log, mas nunca bloqueia a requisição.
RESEND_API_KEY=
EMAIL_FROM=Simulai <no-reply@example.com>

# Usado só por `npm run prisma:seed` para criar o primeiro administrador.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME
SEED_ADMIN_DISPLAY_NAME=Administrador
